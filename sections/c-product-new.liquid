{%- liquid
  assign current_product = section.settings.product
  if current_product == blank
    assign current_product = product
  endif
  assign current_variant = current_product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
-%}

{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch.css' | asset_url | stylesheet_tag }}

<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #CProductNew-{{ section.id }} {
    --cpn-max-width: {{ section.settings.max_width }}px;
    --cpn-background: {{ section.settings.background_color }};
    --cpn-panel-background: {{ section.settings.panel_background_color }};
    --cpn-text: {{ section.settings.text_color }};
    --cpn-muted: {{ section.settings.muted_text_color }};
    --cpn-accent: {{ section.settings.accent_color }};
    --cpn-border: {{ section.settings.border_color }};
    --cpn-button-background: {{ section.settings.button_background_color }};
    --cpn-button-text: {{ section.settings.button_text_color }};
    --cpn-button-transform: {% if section.settings.button_uppercase %}uppercase{% else %}none{% endif %};
    --cpn-title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --cpn-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --cpn-body-size-desktop: {{ section.settings.body_size_desktop }}px;
    --cpn-body-size-mobile: {{ section.settings.body_size_mobile }}px;
    --cpn-price-size-desktop: {{ section.settings.price_size_desktop }}px;
    --cpn-price-size-mobile: {{ section.settings.price_size_mobile }}px;
    --cpn-label-size-desktop: {{ section.settings.label_size_desktop }}px;
    --cpn-label-size-mobile: {{ section.settings.label_size_mobile }}px;
    --cpn-title-weight: {{ section.settings.title_weight }};
    --cpn-body-weight: {{ section.settings.body_weight }};
    --cpn-label-weight: {{ section.settings.label_weight }};
    --cpn-price-weight: {{ section.settings.price_weight }};
    --cpn-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --cpn-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --cpn-padding-inline-desktop: {{ section.settings.padding_inline_desktop }}px;
    --cpn-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --cpn-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --cpn-padding-inline-mobile: {{ section.settings.padding_inline_mobile }}px;
    --cpn-column-gap-desktop: {{ section.settings.column_gap_desktop }}px;
    --cpn-column-gap-mobile: {{ section.settings.column_gap_mobile }}px;
    --cpn-media-radius: {{ section.settings.media_radius }}px;
    --cpn-button-radius: {{ section.settings.button_radius }}px;
    --cpn-thumb-size-desktop: {{ section.settings.thumbnail_size }}px;
    --cpn-thumb-size-mobile: {{ section.settings.thumbnail_size_mobile }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    background: var(--cpn-background);
    color: var(--cpn-text);
  }

  #CProductNew-{{ section.id }} .cpn__inner {
    width: calc(100% - (var(--cpn-padding-inline-mobile) * 2));
    max-width: var(--cpn-max-width);
    margin: 0 auto;
    padding: var(--cpn-padding-top-mobile) 0 var(--cpn-padding-bottom-mobile);
  }

  #CProductNew-{{ section.id }} .cpn__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cpn-column-gap-mobile);
  }

  #CProductNew-{{ section.id }} .cpn__gallery {
    display: grid;
    grid-template-columns: var(--cpn-thumb-size-desktop) minmax(0, 1fr);
    gap: 0.8rem;
    min-width: 0;
  }

  #CProductNew-{{ section.id }} .cpn__thumbs {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    min-width: 0;
  }

  #CProductNew-{{ section.id }} .cpn__thumb {
    display: block;
    width: var(--cpn-thumb-size-desktop);
    height: var(--cpn-thumb-size-desktop);
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0.3rem;
    background: var(--cpn-panel-background);
    overflow: hidden;
    cursor: pointer;
  }

  #CProductNew-{{ section.id }} .cpn__thumb[aria-current='true'] {
    border-color: var(--cpn-accent);
  }

  #CProductNew-{{ section.id }} .cpn__thumb img,
  #CProductNew-{{ section.id }} .cpn__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #CProductNew-{{ section.id }} .cpn__media {
    position: relative;
    aspect-ratio: 1 / 1;
    min-width: 0;
    border-radius: var(--cpn-media-radius);
    background: var(--cpn-panel-background);
    overflow: hidden;
  }

  #CProductNew-{{ section.id }} .cpn__media-button {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  #CProductNew-{{ section.id }} .cpn__zoom-label {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 1;
    padding: 0.6rem 0.8rem;
    background: var(--cpn-button-background);
    color: var(--cpn-button-text);
    font-size: var(--cpn-label-size-mobile);
    font-weight: var(--cpn-label-weight);
    line-height: 1;
    pointer-events: none;
    text-transform: uppercase;
  }

  #CProductNew-{{ section.id }} .cpn__media-item {
    display: none;
    width: 100%;
    height: 100%;
  }

  #CProductNew-{{ section.id }} .cpn__media-item.is-active {
    display: block;
  }

  #CProductNew-{{ section.id }} .cpn__info {
    min-width: 0;
  }

  #CProductNew-{{ section.id }} .cpn__badge {
    display: inline-flex;
    margin-bottom: 0.8rem;
    padding: 0.35rem 0.7rem;
    background: var(--cpn-accent);
    color: var(--cpn-panel-background);
    font-size: var(--cpn-label-size-mobile);
    font-weight: var(--cpn-label-weight);
    line-height: 1;
    text-transform: uppercase;
  }

  #CProductNew-{{ section.id }} .cpn__title {
    margin: 0;
    color: var(--cpn-text);
    font-size: var(--cpn-title-size-mobile);
    font-weight: var(--cpn-title-weight);
    line-height: 1.05;
    text-transform: uppercase;
  }

  #CProductNew-{{ section.id }} .cpn__description,
  #CProductNew-{{ section.id }} .cpn__custom {
    margin-top: 1rem;
    color: var(--cpn-muted);
    font-size: var(--cpn-body-size-mobile);
    font-weight: var(--cpn-body-weight);
    line-height: 1.4;
  }

  #CProductNew-{{ section.id }} .cpn__price {
    margin-top: 1.2rem;
    color: var(--cpn-text);
    font-size: var(--cpn-price-size-mobile);
    font-weight: var(--cpn-price-weight);
    line-height: 1;
  }

  #CProductNew-{{ section.id }} .cpn__benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.3rem 1.5rem;
    margin: 1.2rem 0;
    padding: 1rem 0;
    border-top: 1px solid var(--cpn-border);
    border-bottom: 1px solid var(--cpn-border);
    list-style: none;
  }

  #CProductNew-{{ section.id }} .cpn__benefit {
    color: var(--cpn-text);
    font-size: var(--cpn-body-size-mobile);
    font-weight: var(--cpn-body-weight);
    line-height: 1.35;
  }

  #CProductNew-{{ section.id }} .cpn__benefit::before {
    content: '•';
    margin-right: 0.5rem;
    color: var(--cpn-accent);
  }

  #CProductNew-{{ section.id }} .cpn__option-label {
    display: block;
    margin: 0 0 0.5rem;
    color: var(--cpn-text);
    font-size: var(--cpn-label-size-mobile);
    font-weight: var(--cpn-label-weight);
    line-height: 1.2;
    text-transform: uppercase;
  }

  #CProductNew-{{ section.id }} .cpn__variant-picker {
    margin-top: 0.8rem;
  }

  #CProductNew-{{ section.id }} .product-form__input {
    margin: 0 0 0.8rem;
  }

  #CProductNew-{{ section.id }} .product-form__input .form__label {
    color: var(--cpn-text);
    font-size: var(--cpn-label-size-mobile);
    font-weight: var(--cpn-label-weight);
  }

  #CProductNew-{{ section.id }} .product-form__input--pill input + label {
    min-width: 3.2rem;
    min-height: 3rem;
    margin: 0 0.35rem 0.5rem 0;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--cpn-border);
    border-radius: 0.25rem;
    background: var(--cpn-panel-background);
    color: var(--cpn-text);
    font-size: var(--cpn-label-size-mobile);
    font-weight: var(--cpn-label-weight);
    line-height: 1;
    text-align: center;
  }

  #CProductNew-{{ section.id }} .product-form__input--pill input:checked + label {
    border-color: var(--cpn-button-background);
    background: var(--cpn-button-background);
    color: var(--cpn-button-text);
  }

  #CProductNew-{{ section.id }} .cpn__size-guide {
    display: inline-flex;
    margin: 0.2rem 0 1rem;
    color: var(--cpn-text);
    font-size: var(--cpn-label-size-mobile);
    font-weight: var(--cpn-label-weight);
    text-decoration: underline;
  }

  #CProductNew-{{ section.id }} .cpn__buy-buttons {
    margin-top: 1rem;
  }

  #CProductNew-{{ section.id }} .cpn__buy-buttons .product-form__submit,
  #CProductNew-{{ section.id }} .cpn__buy-buttons .shopify-payment-button__button {
    min-height: 4.2rem;
    border-radius: var(--cpn-button-radius);
    background: var(--cpn-button-background);
    color: var(--cpn-button-text);
    font-size: var(--cpn-body-size-mobile);
    font-weight: var(--cpn-label-weight);
    text-transform: var(--cpn-button-transform);
  }

  #CProductNew-{{ section.id }} .cpn__buy-buttons .shopify-payment-button__button {
    border: 1px solid var(--cpn-button-background);
  }

  #CProductNew-{{ section.id }} .cpn__zoom-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(7, 26, 56, 0.96);
    overscroll-behavior: contain;
  }

  #CProductNew-{{ section.id }} .cpn__zoom-modal.is-open {
    display: flex;
  }

  #CProductNew-{{ section.id }} .cpn__zoom-image {
    max-width: min(92vw, 1200px);
    max-height: 92vh;
    object-fit: contain;
    cursor: zoom-out;
  }

  #CProductNew-{{ section.id }} .cpn__zoom-navigation {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    pointer-events: none;
  }

  #CProductNew-{{ section.id }} .cpn__zoom-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    background: rgba(7, 26, 56, 0.72);
    color: #fff;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
    pointer-events: auto;
  }

  #CProductNew-{{ section.id }} .cpn__zoom-arrow:hover,
  #CProductNew-{{ section.id }} .cpn__zoom-arrow:focus-visible {
    background: #fff;
    color: var(--cpn-accent);
  }

  #CProductNew-{{ section.id }} .cpn__zoom-thumbs {
    position: absolute;
    right: 50%;
    bottom: 1.5rem;
    display: flex;
    gap: 0.6rem;
    max-width: calc(100% - 12rem);
    padding: 0.5rem;
    overflow-x: auto;
    transform: translateX(50%);
  }

  #CProductNew-{{ section.id }} .cpn__zoom-thumb {
    flex: 0 0 5.6rem;
    width: 5.6rem;
    height: 5.6rem;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 0.3rem;
    background: var(--cpn-panel-background);
    overflow: hidden;
    cursor: pointer;
    opacity: 0.72;
  }

  #CProductNew-{{ section.id }} .cpn__zoom-thumb.is-active,
  #CProductNew-{{ section.id }} .cpn__zoom-thumb:hover,
  #CProductNew-{{ section.id }} .cpn__zoom-thumb:focus-visible {
    border-color: #fff;
    opacity: 1;
  }

  #CProductNew-{{ section.id }} .cpn__zoom-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #CProductNew-{{ section.id }} .cpn__zoom-counter {
    position: absolute;
    top: 1.8rem;
    left: 50%;
    color: #fff;
    font-size: var(--cpn-label-size-mobile);
    font-weight: var(--cpn-label-weight);
    transform: translateX(-50%);
  }

  @media screen and (max-width: 749px) {
    #CProductNew-{{ section.id }} .cpn__gallery {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }

    #CProductNew-{{ section.id }} .cpn__media {
      order: 1;
    }

    #CProductNew-{{ section.id }} .cpn__thumbs {
      order: 2;
      flex-direction: row;
      justify-content: flex-start;
      gap: 0.6rem;
      width: 100%;
      padding: 0.1rem 0 0.4rem;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #CProductNew-{{ section.id }} .cpn__thumbs::-webkit-scrollbar {
      display: none;
    }

    #CProductNew-{{ section.id }} .cpn__thumb {
      flex: 0 0 var(--cpn-thumb-size-mobile);
      width: var(--cpn-thumb-size-mobile);
      height: var(--cpn-thumb-size-mobile);
      scroll-snap-align: start;
    }

    #CProductNew-{{ section.id }} .cpn__zoom-modal {
      padding: 1rem;
    }

    #CProductNew-{{ section.id }} .cpn__zoom-navigation {
      padding: 0 0.5rem;
    }

    #CProductNew-{{ section.id }} .cpn__zoom-arrow {
      width: 3.6rem;
      height: 3.6rem;
    }

    #CProductNew-{{ section.id }} .cpn__zoom-thumbs {
      bottom: 1rem;
      max-width: calc(100% - 8rem);
    }

    #CProductNew-{{ section.id }} .cpn__zoom-thumb {
      flex-basis: 4.8rem;
      width: 4.8rem;
      height: 4.8rem;
    }
  }

  #CProductNew-{{ section.id }} .cpn__zoom-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 4rem;
    height: 4rem;
    border: 1px solid #fff;
    border-radius: 50%;
    background: transparent;
    color: #fff;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
  }

  @media screen and (min-width: 750px) {
    #CProductNew-{{ section.id }} .cpn__inner {
      width: calc(100% - (var(--cpn-padding-inline-desktop) * 2));
      padding-top: var(--cpn-padding-top-desktop);
      padding-bottom: var(--cpn-padding-bottom-desktop);
    }

    #CProductNew-{{ section.id }} .cpn__layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(28rem, 0.85fr);
      gap: var(--cpn-column-gap-desktop);
      align-items: start;
    }

    #CProductNew-{{ section.id }} .cpn__badge,
    #CProductNew-{{ section.id }} .cpn__option-label,
    #CProductNew-{{ section.id }} .product-form__input .form__label,
    #CProductNew-{{ section.id }} .cpn__size-guide {
      font-size: var(--cpn-label-size-desktop);
    }

    #CProductNew-{{ section.id }} .cpn__title {
      font-size: var(--cpn-title-size-desktop);
    }

    #CProductNew-{{ section.id }} .cpn__description,
    #CProductNew-{{ section.id }} .cpn__custom,
    #CProductNew-{{ section.id }} .cpn__benefit,
    #CProductNew-{{ section.id }} .cpn__buy-buttons .product-form__submit,
    #CProductNew-{{ section.id }} .cpn__buy-buttons .shopify-payment-button__button {
      font-size: var(--cpn-body-size-desktop);
    }

    #CProductNew-{{ section.id }} .cpn__zoom-label,
    #CProductNew-{{ section.id }} .product-form__input--pill input + label {
      font-size: var(--cpn-label-size-desktop);
    }

    #CProductNew-{{ section.id }} .cpn__price {
      font-size: var(--cpn-price-size-desktop);
    }
  }
{%- endstyle -%}

<product-info
  id="CProductInfo-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ current_product.id }}"
  data-update-url="true"
  data-url="{{ current_product.url }}"
>
<section id="CProductNew-{{ section.id }}" class="c-product-new">
  <div class="cpn__inner">
    {%- if current_product != blank -%}
      <div class="cpn__layout">
        <div class="cpn__gallery" data-cpn-gallery>
          <div class="cpn__thumbs" role="tablist">
            {%- for media in current_product.media -%}
              {%- if media.media_type == 'image' -%}
                <button
                  class="cpn__thumb"
                  type="button"
                  role="tab"
                  aria-label="{{ media.alt | default: current_product.title | escape }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                  data-cpn-thumb="{{ media.id }}"
                >
                  {{ media | image_url: width: 240 | image_tag: loading: 'lazy', alt: media.alt | default: current_product.title }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="cpn__media">
            {%- for media in current_product.media -%}
              {%- if media.media_type == 'image' -%}
                <div class="cpn__media-item{% if forloop.first %} is-active{% endif %}" data-cpn-media="{{ media.id }}">
                  <button
                    class="cpn__media-button"
                    type="button"
                    data-cpn-zoom="{{ media | image_url: width: 2400 }}"
                    aria-label="Zoom {{ media.alt | default: current_product.title | escape }}"
                  >
                    {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', alt: media.alt | default: current_product.title }}
                  </button>
                </div>
              {%- endif -%}
            {%- endfor -%}
            <span class="cpn__zoom-label" aria-hidden="true">+</span>
          </div>
        </div>

        <div class="cpn__info">
          {%- for block in section.blocks -%}
            {%- unless block.type == 'benefit' or block.type == 'variant_picker' or block.type == 'size_guide' or block.type == 'buy_buttons' -%}
            {%- case block.type -%}
              {%- when 'badge' -%}
                {%- if block.settings.text != blank -%}<span class="cpn__badge" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{%- endif -%}
              {%- when 'title' -%}
                <h1 class="cpn__title" {{ block.shopify_attributes }}>{{ current_product.title | escape }}</h1>
              {%- when 'description' -%}
                {%- if block.settings.show_description -%}<div class="cpn__description rte" {{ block.shopify_attributes }}>{{ current_product.description }}</div>{%- endif -%}
              {%- when 'price' -%}
                <div id="price-{{ section.id }}" class="cpn__price" role="status" {{ block.shopify_attributes }}>{{ current_variant.price | money }}</div>
              {%- when 'variant_picker' -%}
                <div class="cpn__variant-picker" {{ block.shopify_attributes }}>
                  {% render 'product-variant-picker', product: current_product, block: block, product_form_id: form_id %}
                </div>
              {%- when 'size_guide' -%}
                {%- if block.settings.label != blank -%}
                  <a class="cpn__size-guide" href="{{ block.settings.link | default: '#' }}" {% if block.settings.link == blank %}data-cpn-size-guide{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
                {%- endif -%}
              {%- when 'buy_buttons' -%}
                <div class="cpn__buy-buttons" {{ block.shopify_attributes }}>
                  {% render 'buy-buttons', block: block, product: current_product, product_form_id: form_id, section_id: section.id, show_pickup_availability: false %}
                </div>
            {%- endcase -%}
            {%- endunless -%}
          {%- endfor -%}

          {%- assign benefit_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' and block.settings.text != blank -%}
              {%- assign benefit_count = benefit_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if benefit_count > 0 -%}
            <ul class="cpn__benefits" role="list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'benefit' and block.settings.text != blank -%}
                  <li class="cpn__benefit" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'variant_picker' -%}
                <div class="cpn__variant-picker" {{ block.shopify_attributes }}>
                  {% render 'product-variant-picker', product: current_product, block: block, product_form_id: form_id %}
                </div>
              {%- when 'size_guide' -%}
                {%- if block.settings.label != blank -%}
                  <a class="cpn__size-guide" href="{{ block.settings.link | default: '#' }}" {% if block.settings.link == blank %}data-cpn-size-guide{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
                {%- endif -%}
              {%- when 'buy_buttons' -%}
                <div class="cpn__buy-buttons" {{ block.shopify_attributes }}>
                  {% render 'buy-buttons', block: block, product: current_product, product_form_id: form_id, section_id: section.id, show_pickup_availability: false %}
                </div>
              {%- when 'custom_liquid' -%}
                <div class="cpn__custom" {{ block.shopify_attributes }}>{{ block.settings.code }}</div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <p>{{ 'sections.featured_product.no_product' | t }}</p>
    {%- endif -%}
  <div
    class="cpn__zoom-modal"
    data-cpn-zoom-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="CProductNewZoomTitle-{{ section.id }}"
    aria-hidden="true"
    tabindex="-1"
  >
    <h2 id="CProductNewZoomTitle-{{ section.id }}" class="visually-hidden">
      {{ current_product.title | escape }}
    </h2>
    <button class="cpn__zoom-close" type="button" data-cpn-zoom-close aria-label="Cerrar zoom">&times;</button>
    <span class="cpn__zoom-counter" data-cpn-zoom-counter aria-live="polite"></span>
    <div class="cpn__zoom-navigation" aria-label="Navegación de galería">
      <button class="cpn__zoom-arrow" type="button" data-cpn-zoom-prev aria-label="Imagen anterior">&#8249;</button>
      <button class="cpn__zoom-arrow" type="button" data-cpn-zoom-next aria-label="Imagen siguiente">&#8250;</button>
    </div>
    <img class="cpn__zoom-image" data-cpn-zoom-image alt="">
    <div class="cpn__zoom-thumbs" data-cpn-zoom-thumbs role="tablist" aria-label="Imágenes del producto"></div>
  </div>
</section>
</product-info>

<script>
  (() => {
    const root = document.querySelector('#CProductNew-{{ section.id }}');
    if (!root) return;
    const thumbs = root.querySelectorAll('[data-cpn-thumb]');
    const media = root.querySelectorAll('[data-cpn-media]');
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const id = thumb.dataset.cpnThumb;
        thumbs.forEach((item) => item.setAttribute('aria-current', item === thumb ? 'true' : 'false'));
        media.forEach((item) => item.classList.toggle('is-active', item.dataset.cpnMedia === id));
      thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    });
    });
    const modal = root.querySelector('[data-cpn-zoom-modal]');
    if (!modal) return;
    const modalImage = modal.querySelector('[data-cpn-zoom-image]');
    const modalCounter = modal.querySelector('[data-cpn-zoom-counter]');
    const modalThumbs = modal.querySelector('[data-cpn-zoom-thumbs]');
    const previousButton = modal.querySelector('[data-cpn-zoom-prev]');
    const nextButton = modal.querySelector('[data-cpn-zoom-next]');
    const zoomButtons = Array.from(root.querySelectorAll('[data-cpn-zoom]'));
    let activeIndex = 0;
    let lastFocusedElement;
    const galleryImages = zoomButtons.map((button) => ({
      src: button.dataset.cpnZoom,
      alt: button.getAttribute('aria-label') || '',
      thumb: button.closest('[data-cpn-media]')?.querySelector('img')?.currentSrc || button.closest('[data-cpn-media]')?.querySelector('img')?.src || '',
    }));
    const renderThumbnails = () => {
      modalThumbs.innerHTML = galleryImages
        .map(
          (image, index) => `
            <button class="cpn__zoom-thumb${index === activeIndex ? ' is-active' : ''}" type="button" role="tab"
              aria-label="Ver imagen ${index + 1}" aria-selected="${index === activeIndex}" data-cpn-zoom-index="${index}">
              <img src="${image.thumb}" alt="">
            </button>
          `
        )
        .join('');
      modalThumbs.querySelectorAll('[data-cpn-zoom-index]').forEach((thumbnail) => {
        thumbnail.addEventListener('click', () => showImage(Number(thumbnail.dataset.cpnZoomIndex)));
      });
    };
    const showImage = (index) => {
      if (!galleryImages.length) return;
      activeIndex = (index + galleryImages.length) % galleryImages.length;
      const image = galleryImages[activeIndex];
      modalImage.src = image.src;
      modalImage.alt = image.alt;
      modalCounter.textContent = `${activeIndex + 1} / ${galleryImages.length}`;
      modalThumbs.querySelectorAll('[data-cpn-zoom-index]').forEach((thumbnail) => {
        const isActive = Number(thumbnail.dataset.cpnZoomIndex) === activeIndex;
        thumbnail.classList.toggle('is-active', isActive);
        thumbnail.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
    };
    const closeModal = () => {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      modalImage.removeAttribute('src');
      document.body.classList.remove('overflow-hidden');
      lastFocusedElement?.focus();
    };
    zoomButtons.forEach((button, index) => {
      button.addEventListener('click', () => {
        lastFocusedElement = button;
        activeIndex = index;
        renderThumbnails();
        showImage(activeIndex);
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('overflow-hidden');
        modal.focus();
      });
    });
    previousButton.addEventListener('click', () => showImage(activeIndex - 1));
    nextButton.addEventListener('click', () => showImage(activeIndex + 1));
    modalImage.addEventListener('click', closeModal);
    modal.querySelector('[data-cpn-zoom-close]').addEventListener('click', closeModal);
    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });
    modal.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
      if (event.key === 'ArrowLeft' && modal.classList.contains('is-open')) showImage(activeIndex - 1);
      if (event.key === 'ArrowRight' && modal.classList.contains('is-open')) showImage(activeIndex + 1);
    });
  })();
</script>

