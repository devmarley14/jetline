{%- liquid
  assign desktop_columns = section.settings.columns_desktop | plus: 0
  assign mobile_columns = section.settings.columns_mobile | plus: 0
  assign desktop_slider = false
  assign mobile_slider = false
  if section.blocks.size > desktop_columns
    assign desktop_slider = true
  endif
  if section.settings.enable_mobile_slider
    assign mobile_slider = true
  endif
-%}

{%- style -%}
  #DevCollectionCarousel-{{ section.id }} {
    --dev-category-columns-desktop: {{ desktop_columns }};
    --dev-category-columns-mobile: {{ mobile_columns }};
    --dev-category-gap: {{ section.settings.card_gap }}px;
    --dev-category-card-radius: {{ section.settings.card_radius }}px;
    --dev-category-section-max-width: {{ section.settings.section_max_width }}px;
    --dev-category-heading-max-width: {{ section.settings.heading_max_width }}px;
    --dev-category-card-title-max-width: {{ section.settings.card_title_max_width }}px;
    --dev-category-card-padding-desktop: {{ section.settings.card_padding_desktop }}px;
    --dev-category-card-padding-mobile: {{ section.settings.card_padding_mobile }}px;
    --dev-category-button-height-desktop: {{ section.settings.button_height_desktop }}px;
    --dev-category-button-height-mobile: {{ section.settings.button_height_mobile }}px;
    --dev-category-image-ratio: {{ section.settings.image_ratio }};
    --dev-category-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --dev-category-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --dev-category-title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --dev-category-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --dev-category-button-size-desktop: {{ section.settings.button_size_desktop }}px;
    --dev-category-button-size-mobile: {{ section.settings.button_size_mobile }}px;
    --dev-category-counter-size-desktop: {{ section.settings.counter_size_desktop }}px;
    --dev-category-counter-size-mobile: {{ section.settings.counter_size_mobile }}px;
    --dev-category-heading-weight: {{ section.settings.heading_weight }};
    --dev-category-title-weight: {{ section.settings.title_weight }};
    --dev-category-button-weight: {{ section.settings.button_weight }};
    --dev-category-counter-weight: {{ section.settings.counter_weight }};
    --dev-category-title-color: {{ section.settings.title_color }};
    --dev-category-button-background: {{ section.settings.button_background }};
    --dev-category-button-text: {{ section.settings.button_text_color }};
    --dev-category-button-border: {{ section.settings.button_border_color }};
    --dev-category-section-background: {{ section.settings.background_color }};
    --dev-category-section-padding-top: {{ section.settings.padding_top }}px;
    --dev-category-section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="DevCollectionCarousel-{{ section.id }}"
  class="dev-category-section{% if section.settings.full_width %} dev-category-section--full-width{% endif %}"
  aria-labelledby="DevCollectionHeading-{{ section.id }}"
>
  <div class="dev-category-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 id="DevCollectionHeading-{{ section.id }}" class="dev-category-section__heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <slider-component class="dev-category-carousel{% if desktop_slider %} dev-category-carousel--desktop-slider{% endif %}{% if mobile_slider %} dev-category-carousel--mobile-slider{% endif %} dev-category-carousel--mobile-columns-{{ mobile_columns }}">
      <ul
        id="Slider-{{ section.id }}"
        class="dev-category-carousel__track{% if desktop_slider %} dev-category-carousel__track--desktop-slider{% endif %}{% if mobile_slider %} dev-category-carousel__track--mobile-slider{% endif %}"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li id="Slide-{{ section.id }}-{{ forloop.index }}" class="dev-category-card" {{ block.shopify_attributes }}>
            <div class="dev-category-card__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '320, 480, 640, 800, 1000, 1200',
                    sizes: '(min-width: 990px) calc(100vw / var(--dev-category-columns-desktop)), 82vw',
                    loading: 'lazy',
                    alt: block.settings.image_alt
                }}
              {%- else -%}
                {%- assign placeholder_index = forloop.index | modulo: 4 | plus: 1 -%}
                {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_index -%}
                {{ placeholder_image | placeholder_svg_tag: 'dev-category-card__placeholder' }}
              {%- endif -%}
            </div>
            <div class="dev-category-card__footer">
              {%- if block.settings.title != blank -%}
                <h3 class="dev-category-card__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.collection_link != blank -%}
                <a class="dev-category-card__button" href="{{ block.settings.collection_link }}">
                  {{ block.settings.button_label | default: section.settings.button_label | escape }}
                  <span aria-hidden="true">→</span>
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if desktop_slider or mobile_slider -%}
        <div class="dev-category-carousel__controls{% if desktop_slider == false %} dev-category-carousel__controls--mobile-only{% endif %}">
          <button type="button" class="dev-category-carousel__arrow" name="previous" aria-label="Anterior" aria-controls="Slider-{{ section.id }}">
            <span aria-hidden="true">←</span>
          </button>
          <div class="dev-category-carousel__counter" aria-live="polite">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button type="button" class="dev-category-carousel__arrow" name="next" aria-label="Siguiente" aria-controls="Slider-{{ section.id }}">
            <span aria-hidden="true">→</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</section>

{%- style -%}
  #DevCollectionCarousel-{{ section.id }}.dev-category-section {
    background: var(--dev-category-section-background);
    padding: var(--dev-category-section-padding-top) 0 var(--dev-category-section-padding-bottom);
    overflow: hidden;
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-section__inner {
    width: min(calc(100% - 3rem), var(--dev-category-section-max-width));
    max-width: var(--dev-category-section-max-width);
    margin: 0 auto;
  }

  #DevCollectionCarousel-{{ section.id }}.dev-category-section--full-width .dev-category-section__inner {
    width: 100%;
    max-width: var(--dev-category-section-max-width);
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-section__heading {
    margin: 0 0 2.4rem;
    color: var(--dev-category-title-color);
    font-size: var(--dev-category-heading-size-mobile);
    font-weight: var(--dev-category-heading-weight);
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    max-width: var(--dev-category-heading-max-width);
    margin-right: auto;
    margin-left: auto;
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-carousel {
    display: block;
    position: relative;
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__track {
    display: grid;
    grid-template-columns: repeat(var(--dev-category-columns-mobile), minmax(0, 1fr));
    gap: var(--dev-category-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (max-width: 749px) {
    #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__track--mobile-slider {
      display: flex;
      gap: var(--dev-category-gap);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      padding: 0 max(1.5rem, calc((100% - 82vw) / 2));
    }

    #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__track--mobile-slider::-webkit-scrollbar {
      display: none;
    }

    #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__track--mobile-slider .dev-category-card {
      flex: 0 0 calc((100% - (var(--dev-category-columns-mobile) - 1) * var(--dev-category-gap)) / var(--dev-category-columns-mobile));
    }

    #DevCollectionCarousel-{{ section.id }} .dev-category-carousel--mobile-columns-1 .dev-category-carousel__track--mobile-slider .dev-category-card {
      flex-basis: 82vw;
    }
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--dev-category-card-radius);
    background: #f2f2f2;
    scroll-snap-align: center;
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--dev-category-image-ratio);
    overflow: hidden;
    background: #f2f2f2;
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-card__media img,
  #DevCollectionCarousel-{{ section.id }} .dev-category-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-card__media img {
    position: absolute;
    inset: 0;
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-card:hover .dev-category-card__media img,
  #DevCollectionCarousel-{{ section.id }} .dev-category-card:focus-within .dev-category-card__media img {
    transform: scale(1.04);
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-card__footer {
    position: relative;
    z-index: 1;
    min-height: 6.8rem;
    padding: var(--dev-category-card-padding-mobile);
    text-align: center;
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-card__title {
    margin: 0;
    color: var(--dev-category-title-color);
    font-size: var(--dev-category-title-size-mobile);
    font-weight: var(--dev-category-title-weight);
    line-height: 1.2;
    text-transform: uppercase;
    max-width: var(--dev-category-card-title-max-width);
    margin-right: auto;
    margin-left: auto;
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-card__button {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    min-height: var(--dev-category-button-height-mobile);
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    border: 1px solid var(--dev-category-button-border);
    background: var(--dev-category-button-background);
    color: var(--dev-category-button-text);
    font-size: var(--dev-category-button-size-mobile);
    font-weight: var(--dev-category-button-weight);
    line-height: 1.2;
    text-decoration: none;
    opacity: 0;
    transform: translateY(0.8rem);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-card:hover .dev-category-card__button,
  #DevCollectionCarousel-{{ section.id }} .dev-category-card:focus-within .dev-category-card__button {
    opacity: 1;
    transform: translateY(0);
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.4rem;
    margin-top: 2rem;
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__arrow {
    display: inline-flex;
    width: 4rem;
    height: 4rem;
    align-items: center;
    justify-content: center;
    flex: 0 0 4rem;
    border: 1px solid #d9dde3;
    border-radius: 50%;
    background: #f1f2f4;
    color: #8a929d;
    cursor: pointer;
    transition: width 0.2s ease, flex-basis 0.2s ease, border-radius 0.2s ease, background-color 0.2s ease,
      border-color 0.2s ease, color 0.2s ease;
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__arrow:not(:disabled) {
    width: 6.4rem;
    flex-basis: 6.4rem;
    border-color: var(--dev-category-button-background);
    border-radius: 0.4rem;
    background: var(--dev-category-button-background);
    color: var(--dev-category-button-text);
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__arrow:disabled {
    cursor: not-allowed;
    opacity: 1;
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__counter {
    color: var(--dev-category-title-color);
    font-size: var(--dev-category-counter-size-mobile);
    font-weight: var(--dev-category-counter-weight);
  }

  #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__controls--mobile-only {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__controls--mobile-only {
      display: flex;
    }
  }

  @media screen and (min-width: 750px) {
    #DevCollectionCarousel-{{ section.id }} .dev-category-section__inner {
      width: min(calc(100% - 10rem), var(--dev-category-section-max-width));
      max-width: var(--dev-category-section-max-width);
    }

    #DevCollectionCarousel-{{ section.id }}.dev-category-section--full-width .dev-category-section__inner {
      width: 100%;
      max-width: var(--dev-category-section-max-width);
    }

    #DevCollectionCarousel-{{ section.id }} .dev-category-section__heading {
      margin-bottom: 3rem;
      font-size: var(--dev-category-heading-size-desktop);
    }

    #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__track {
      display: grid;
      overflow: visible;
      grid-template-columns: repeat(var(--dev-category-columns-desktop), minmax(0, 1fr));
      padding: 0;
      scroll-snap-type: none;
    }

    #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__track--mobile-slider {
      display: grid;
      overflow: visible;
      padding: 0;
      scroll-snap-type: none;
    }

    #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__track--desktop-slider {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
    }

    #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__track--desktop-slider::-webkit-scrollbar {
      display: none;
    }

    #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__track--desktop-slider .dev-category-card {
      flex: 0 0 calc((100% - (var(--dev-category-columns-desktop) - 1) * var(--dev-category-gap)) / var(--dev-category-columns-desktop));
    }

    #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__track:not(.dev-category-carousel__track--desktop-slider) .dev-category-card {
      flex: initial;
    }

    #DevCollectionCarousel-{{ section.id }} .dev-category-card__title {
      font-size: var(--dev-category-title-size-desktop);
    }

    #DevCollectionCarousel-{{ section.id }} .dev-category-card__footer {
      padding: var(--dev-category-card-padding-desktop);
    }

    #DevCollectionCarousel-{{ section.id }} .dev-category-card__button {
      font-size: var(--dev-category-button-size-desktop);
      min-height: var(--dev-category-button-height-desktop);
    }

    #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__counter {
      font-size: var(--dev-category-counter-size-desktop);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #DevCollectionCarousel-{{ section.id }} .dev-category-carousel__track,
    #DevCollectionCarousel-{{ section.id }} .dev-category-card__media img,
    #DevCollectionCarousel-{{ section.id }} .dev-category-card__button {
      scroll-behavior: auto;
      transition: none;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Dev - Shop by category",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Shop by category"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columnas Desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "6"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columnas Mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_slider",
      "label": "Activar carrusel Mobile con peek",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho completo",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de imagen",
      "options": [
        { "value": "1 / 1", "label": "Cuadrada" },
        { "value": "4 / 5", "label": "Vertical" },
        { "value": "3 / 4", "label": "Retrato" },
        { "value": "4 / 3", "label": "Horizontal" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "header",
      "content": "Layout y espaciado"
    },
    {
      "type": "range",
      "id": "section_max_width",
      "label": "Ancho máximo de la sección",
      "min": 960,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Ancho máximo del título de sección",
      "min": 240,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "card_title_max_width",
      "label": "Ancho máximo del título de card",
      "min": 120,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "card_padding_desktop",
      "label": "Padding de card Desktop",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding_mobile",
      "label": "Padding de card Mobile",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_height_desktop",
      "label": "Altura de botón Desktop",
      "min": 28,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "button_height_mobile",
      "label": "Altura de botón Mobile",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Tamaño título de sección Desktop",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Tamaño título de sección Mobile",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Peso título de sección",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Tamaño título de card Desktop",
      "min": 10,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Tamaño título de card Mobile",
      "min": 10,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Peso título de card",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "button_size_desktop",
      "label": "Tamaño texto botón Desktop",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "button_size_mobile",
      "label": "Tamaño texto botón Mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "button_weight",
      "label": "Peso texto botón",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "counter_size_desktop",
      "label": "Tamaño contador Desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "counter_size_mobile",
      "label": "Tamaño contador Mobile",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "counter_weight",
      "label": "Peso contador",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Separación entre cards",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Radio de cards",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "text",
