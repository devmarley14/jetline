{%- liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
  assign desktop_text_alignment = 'left'
  assign mobile_text_alignment = 'left'
  if section.settings.desktop_content_alignment == 'center'
    assign desktop_text_alignment = 'center'
  elsif section.settings.desktop_content_alignment == 'flex-end'
    assign desktop_text_alignment = 'right'
  endif
  if section.settings.mobile_content_alignment == 'center'
    assign mobile_text_alignment = 'center'
  elsif section.settings.mobile_content_alignment == 'flex-end'
    assign mobile_text_alignment = 'right'
  endif
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign image_widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- style -%}
  #DevBanner-{{ section.id }} {
    --dev-banner-height-desktop: {{ section.settings.desktop_height }}px;
    --dev-banner-height-mobile: {{ section.settings.mobile_height }}px;
    --dev-banner-content-max-desktop: {{ section.settings.desktop_content_max_width }}px;
    --dev-banner-content-max-mobile: {{ section.settings.mobile_content_max_width }}px;
    --dev-banner-content-padding-desktop: {{ section.settings.desktop_padding }}px;
    --dev-banner-content-padding-mobile: {{ section.settings.mobile_padding }}px;
    --dev-banner-heading-size-desktop: {{ section.settings.desktop_heading_size }}px;
    --dev-banner-heading-size-mobile: {{ section.settings.mobile_heading_size }}px;
    --dev-banner-text-size-desktop: {{ section.settings.desktop_text_size }}px;
    --dev-banner-text-size-mobile: {{ section.settings.mobile_text_size }}px;
    --dev-banner-heading-color: {{ section.settings.heading_color }};
    --dev-banner-text-color: {{ section.settings.text_color }};
    --dev-banner-overlay: {{ section.settings.overlay_color | color_modify: 'alpha', overlay_opacity }};
    --dev-banner-button-background: {{ section.settings.button_background }};
    --dev-banner-button-text: {{ section.settings.button_text_color }};
    --dev-banner-button-border: {{ section.settings.button_border_color }};
    --dev-banner-radius: {{ section.settings.corner_radius }}px;
    --dev-banner-content-align-desktop: {{ section.settings.desktop_content_alignment }};
    --dev-banner-content-align-mobile: {{ section.settings.mobile_content_alignment }};
    --dev-banner-text-align-desktop: {{ desktop_text_alignment }};
    --dev-banner-text-align-mobile: {{ mobile_text_alignment }};
    --dev-banner-object-position-desktop: {{ section.settings.desktop_image_position }};
    --dev-banner-object-position-mobile: {{ section.settings.mobile_image_position }};
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  #DevBanner-{{ section.id }} .dev-banner__media,
  #DevBanner-{{ section.id }} .dev-banner__media::after {
    border-radius: var(--dev-banner-radius);
  }
{%- endstyle -%}

<section
  id="DevBanner-{{ section.id }}"
  class="dev-banner{% if section.settings.full_width %} dev-banner--full-width{% endif %}"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="dev-banner__media">
    {%- if desktop_image != blank or mobile_image != blank -%}
      <picture>
        {%- if section.settings.mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1100 }} 1100w,
              {{ mobile_image | image_url: width: 1500 }} 1500w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          desktop_image
          | default: mobile_image
          | image_url: width: 3840
          | image_tag:
            widths: image_widths,
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: fetch_priority,
            class: 'dev-banner__image',
            alt: section.settings.image_alt
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'dev-banner__placeholder' }}
    {%- endif -%}
  </div>

  <div class="dev-banner__content">
    <div class="dev-banner__content-inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="dev-banner__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
            {%- endif -%}
          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="dev-banner__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}
          {%- when 'buttons' -%}
            {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
              <div class="dev-banner__buttons" {{ block.shopify_attributes }}>
                {%- if block.settings.button_label_1 != blank -%}
                  <a class="dev-banner__button{% if block.settings.button_style_secondary_1 %} dev-banner__button--secondary{% endif %}" href="{{ block.settings.button_link_1 | default: '#' }}">
                    {{ block.settings.button_label_1 | escape }}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a class="dev-banner__button{% if block.settings.button_style_secondary_2 %} dev-banner__button--secondary{% endif %}" href="{{ block.settings.button_link_2 | default: '#' }}">
                    {{ block.settings.button_label_2 | escape }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  #DevBanner-{{ section.id }}.dev-banner {
    position: relative;
    min-height: var(--dev-banner-height-mobile);
    overflow: hidden;
    isolation: isolate;
  }

  #DevBanner-{{ section.id }} .dev-banner__media,
  #DevBanner-{{ section.id }} .dev-banner__media::after,
  #DevBanner-{{ section.id }} .dev-banner__image,
  #DevBanner-{{ section.id }} .dev-banner__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #DevBanner-{{ section.id }} .dev-banner__media {
    z-index: -1;
  }

  #DevBanner-{{ section.id }} .dev-banner__media::after {
    content: '';
    background: var(--dev-banner-overlay);
  }

  #DevBanner-{{ section.id }} .dev-banner__image {
    object-fit: cover;
    object-position: var(--dev-banner-object-position-mobile);
  }

  #DevBanner-{{ section.id }} .dev-banner__content {
    display: flex;
    min-height: inherit;
    align-items: center;
    justify-content: var(--dev-banner-content-align-mobile);
    padding: var(--dev-banner-content-padding-mobile);
  }

  #DevBanner-{{ section.id }} .dev-banner__content-inner {
    width: 100%;
    max-width: var(--dev-banner-content-max-mobile);
    color: var(--dev-banner-text-color);
    text-align: var(--dev-banner-text-align-mobile);
  }

  #DevBanner-{{ section.id }} .dev-banner__heading {
    margin: 0;
    color: var(--dev-banner-heading-color);
    font-size: var(--dev-banner-heading-size-mobile);
    line-height: 1.05;
  }

  #DevBanner-{{ section.id }} .dev-banner__text {
    margin-top: 1.5rem;
    color: var(--dev-banner-text-color);
    font-size: var(--dev-banner-text-size-mobile);
    line-height: 1.45;
  }

  #DevBanner-{{ section.id }} .dev-banner__text p {
    margin: 0;
  }

  #DevBanner-{{ section.id }} .dev-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: inherit;
    gap: 1rem;
    margin-top: 2rem;
  }

  #DevBanner-{{ section.id }} .dev-banner__button {
    display: inline-flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 2rem;
    border: 1px solid var(--dev-banner-button-border);
    border-radius: 0.3rem;
    background: var(--dev-banner-button-background);
    color: var(--dev-banner-button-text);
    font: inherit;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }

  #DevBanner-{{ section.id }} .dev-banner__button--secondary {
    background: transparent;
    color: var(--dev-banner-button-border);
  }

  @media screen and (min-width: 750px) {
    #DevBanner-{{ section.id }}.dev-banner {
      min-height: var(--dev-banner-height-desktop);
    }

    #DevBanner-{{ section.id }} .dev-banner__image {
      object-position: var(--dev-banner-object-position-desktop);
    }

    #DevBanner-{{ section.id }} .dev-banner__content {
      justify-content: var(--dev-banner-content-align-desktop);
      padding: var(--dev-banner-content-padding-desktop);
    }

    #DevBanner-{{ section.id }} .dev-banner__content-inner {
      max-width: var(--dev-banner-content-max-desktop);
      text-align: var(--dev-banner-text-align-desktop);
    }

    #DevBanner-{{ section.id }} .dev-banner__heading {
      font-size: var(--dev-banner-heading-size-desktop);
    }

    #DevBanner-{{ section.id }} .dev-banner__text {
      font-size: var(--dev-banner-text-size-desktop);
    }
  }

  @media screen and (min-width: 750px) {
    #DevBanner-{{ section.id }}.dev-banner:not(.dev-banner--full-width) {
      margin-right: auto;
      margin-left: auto;
      max-width: var(--page-width);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dev - Banner responsive",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Usa nombres de archivo con el formato Dev - nombre de la sección - Desktop y Dev - nombre de la sección - Mobile."
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Etiqueta accesible",
      "default": "Banner principal"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Dev - Imagen Desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Dev - Imagen Mobile"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo de la imagen",
      "default": "Banner promocional"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho completo",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Altura Desktop",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Altura Mobile",
      "min": 180,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "desktop_content_max_width",
      "label": "Max-width contenido Desktop",
      "min": 240,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "mobile_content_max_width",
      "label": "Max-width contenido Mobile",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 340
    },
    {
      "type": "range",
      "id": "desktop_padding",
      "label": "Padding Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Padding Mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "label": "Tamaño título Desktop",
      "min": 16,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Tamaño título Mobile",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "desktop_text_size",
      "label": "Tamaño texto Desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Tamaño texto Mobile",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "label": "Alineación Desktop",
      "options": [
        { "value": "flex-start", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Derecha" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "label": "Alineación Mobile",
      "options": [
        { "value": "flex-start", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Posición imagen Desktop",
      "options": [
        { "value": "left center", "label": "Izquierda" },
        { "value": "center center", "label": "Centro" },
        { "value": "right center", "label": "Derecha" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Posición imagen Mobile",
      "options": [
        { "value": "left center", "label": "Izquierda" },
        { "value": "center center", "label": "Centro" },
        { "value": "right center", "label": "Derecha" }
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidad overlay",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Fondo de botón",
      "default": "#13294b"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Texto de botón",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Borde de botón",
      "default": "#13294b"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Radio de esquinas",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margen superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Título",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Título",
          "default": "Built for those who fly higher."
        }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Performance aviation apparel engineered for pilots, crew and aviation professionals around the world.</p>"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Botones",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label_1",
          "label": "Texto botón 1",
          "default": "Shop pilot shirts"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Enlace botón 1"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_1",
          "label": "Botón 1 secundario",
          "default": false
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Texto botón 2",
          "default": "Explore collection"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Enlace botón 2"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_2",
          "label": "Botón 2 secundario",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dev - Banner responsive",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
