      "label": "Tamaño título beneficio Desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "benefit_title_size_mobile",
      "label": "Tamaño título beneficio Mobile",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "benefit_text_size_desktop",
      "label": "Tamaño descripción beneficio Desktop",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "benefit_text_size_mobile",
      "label": "Tamaño descripción beneficio Mobile",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "icon_size_desktop",
      "label": "Tamaño icono Desktop",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Tamaño icono Mobile",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "benefit_gap",
      "label": "Separación de beneficios",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_margin_top",
      "label": "Margen superior del botón Mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "button_margin_top_desktop",
      "label": "Margen superior del botón Desktop",
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Radio de imagen",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "color",
