{%- style -%}
  #DevProductFeature-{{ section.id }} {
    --dev-feature-background: {{ section.settings.background_color }};
    --dev-feature-text: {{ section.settings.text_color }};
    --dev-feature-muted: {{ section.settings.description_color }};
    --dev-feature-accent: {{ section.settings.accent_color }};
    --dev-feature-button-background: {{ section.settings.button_background }};
    --dev-feature-button-text: {{ section.settings.button_text_color }};
    --dev-feature-button-border: {{ section.settings.button_border_color }};
    --dev-feature-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --dev-feature-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --dev-feature-body-desktop: {{ section.settings.body_size_desktop }}px;
    --dev-feature-body-mobile: {{ section.settings.body_size_mobile }}px;
    --dev-feature-benefit-title-desktop: {{ section.settings.benefit_title_size_desktop }}px;
    --dev-feature-benefit-title-mobile: {{ section.settings.benefit_title_size_mobile }}px;
    --dev-feature-benefit-text-desktop: {{ section.settings.benefit_text_size_desktop }}px;
    --dev-feature-benefit-text-mobile: {{ section.settings.benefit_text_size_mobile }}px;
    --dev-feature-eyebrow-weight: {{ section.settings.eyebrow_weight }};
    --dev-feature-heading-weight: {{ section.settings.heading_weight }};
    --dev-feature-body-weight: {{ section.settings.body_weight }};
    --dev-feature-benefit-title-weight: {{ section.settings.benefit_title_weight }};
    --dev-feature-benefit-text-weight: {{ section.settings.benefit_text_weight }};
    --dev-feature-button-weight: {{ section.settings.button_weight }};
    --dev-feature-button-margin-top: {{ section.settings.button_margin_top }}px;
    --dev-feature-button-margin-top-desktop: {{ section.settings.button_margin_top_desktop }}px;
    --dev-feature-icon-desktop: {{ section.settings.icon_size_desktop }}px;
    --dev-feature-icon-mobile: {{ section.settings.icon_size_mobile }}px;
    --dev-feature-benefits-columns: {{ section.settings.columns_desktop }};
    --dev-feature-gap: {{ section.settings.benefit_gap }}px;
    --dev-feature-padding-top: {{ section.settings.padding_top }}px;
    --dev-feature-padding-bottom: {{ section.settings.padding_bottom }}px;
    --dev-feature-section-max-width: {{ section.settings.section_max_width }}px;
    --dev-feature-padding-inline-desktop: {{ section.settings.padding_inline_desktop }}px;
    --dev-feature-padding-inline-mobile: {{ section.settings.padding_inline_mobile }}px;
    --dev-feature-content-padding-inline-desktop: {{ section.settings.content_padding_inline_desktop }}px;
    --dev-feature-content-padding-inline-mobile: {{ section.settings.content_padding_inline_mobile }}px;
    --dev-feature-radius: {{ section.settings.image_radius }}px;
  }
{%- endstyle -%}

<section id="DevProductFeature-{{ section.id }}" class="dev-product-feature" aria-labelledby="DevProductFeatureHeading-{{ section.id }}">
  <div class="dev-product-feature__inner{% if section.settings.full_width %} dev-product-feature__inner--full-width{% endif %}">
    <div class="dev-product-feature__media{% if section.settings.image_position == 'right' %} dev-product-feature__media--right{% endif %}">
      {%- if section.settings.product_image != blank -%}
        {{
          section.settings.product_image
          | image_url: width: 1800
          | image_tag:
            widths: '480, 720, 960, 1200, 1500, 1800',
            sizes: '(min-width: 990px) 50vw, 100vw',
            loading: 'lazy',
            alt: section.settings.image_alt
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'dev-product-feature__placeholder' }}
      {%- endif -%}
    </div>

    <div class="dev-product-feature__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="dev-product-feature__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 id="DevProductFeatureHeading-{{ section.id }}" class="dev-product-feature__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="dev-product-feature__description rte">{{ section.settings.description }}</div>
      {%- endif -%}

      <ul class="dev-product-feature__benefits" role="list">
        {%- for block in section.blocks -%}
          <li class="dev-product-feature__benefit" {{ block.shopify_attributes }}>
            <div class="dev-product-feature__icon" aria-hidden="true">
              {%- if block.settings.svg_code != blank -%}
                {{ block.settings.svg_code }}
              {%- elsif block.settings.icon_image != blank -%}
                {{ block.settings.icon_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
              {%- else -%}
                {{ 'icon-star' | inline_asset_content }}
              {%- endif -%}
            </div>
            <div class="dev-product-feature__benefit-copy">
              {%- if block.settings.title != blank -%}
                <h3>{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <div class="rte">{{ block.settings.description }}</div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.button_label != blank -%}
        <a class="dev-product-feature__button" href="{{ section.settings.button_link | default: '#' }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{%- style -%}
  #DevProductFeature-{{ section.id }}.dev-product-feature {
    overflow: hidden;
    background: var(--dev-feature-background);
    padding: var(--dev-feature-padding-top) 0 var(--dev-feature-padding-bottom);
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__inner {
    display: grid;
    width: min(
      calc(100% - (var(--dev-feature-padding-inline-mobile) * 2)),
      var(--dev-feature-section-max-width)
    );
    max-width: var(--dev-feature-section-max-width);
    box-sizing: border-box;
    margin: 0 auto;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__inner--full-width {
    width: 100%;
    max-width: none;
    padding-right: var(--dev-feature-padding-inline-mobile);
    padding-left: var(--dev-feature-padding-inline-mobile);
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__media {
    width: 100%;
    max-width: none;
    margin: 0;
    overflow: hidden;
    border-radius: var(--dev-feature-radius);
    line-height: 0;
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__media img,
  #DevProductFeature-{{ section.id }} .dev-product-feature__placeholder {
    display: block;
    width: 100%;
    height: auto;
    max-height: 72rem;
    object-fit: cover;
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__content {
    color: var(--dev-feature-text);
    padding-right: var(--dev-feature-content-padding-inline-mobile);
    padding-left: var(--dev-feature-content-padding-inline-mobile);
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__eyebrow {
    margin: 0 0 1rem;
    color: var(--dev-feature-text);
    font-size: var(--dev-feature-body-mobile);
    font-weight: var(--dev-feature-eyebrow-weight);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__heading {
    margin: 0;
    color: var(--dev-feature-text);
    font-size: var(--dev-feature-heading-mobile);
    font-weight: var(--dev-feature-heading-weight);
    line-height: 1.1;
    text-transform: uppercase;
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__description {
    margin-top: 1.6rem;
    color: var(--dev-feature-muted);
    font-size: var(--dev-feature-body-mobile);
    font-weight: var(--dev-feature-body-weight);
    line-height: 1.5;
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__description p {
    margin: 0;
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__benefits {
    display: flex;
    flex-wrap: wrap;
    margin: 2.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__benefit {
    display: flex;
    width: 33.333%;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 0.6rem;
    border-right: 1px solid color-mix(in srgb, var(--dev-feature-text) 18%, transparent);
    text-align: center;
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__benefit:nth-child(3n) {
    border-right: 0;
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__icon {
    display: flex;
    width: var(--dev-feature-icon-mobile);
    height: var(--dev-feature-icon-mobile);
    align-items: center;
    justify-content: center;
    color: var(--dev-feature-accent);
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__icon svg,
  #DevProductFeature-{{ section.id }} .dev-product-feature__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__benefit-copy h3 {
    margin: 0;
    color: var(--dev-feature-text);
    font-size: var(--dev-feature-benefit-title-mobile);
    font-weight: var(--dev-feature-benefit-title-weight);
    line-height: 1.2;
    text-transform: uppercase;
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__benefit-copy .rte {
    margin-top: 0.5rem;
    color: var(--dev-feature-muted);
    font-size: var(--dev-feature-benefit-text-mobile);
    font-weight: var(--dev-feature-benefit-text-weight);
    line-height: 1.35;
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__benefit-copy .rte p {
    margin: 0;
  }

  #DevProductFeature-{{ section.id }} .dev-product-feature__button {
    display: inline-flex;
    min-height: 4.8rem;
    align-items: center;
    justify-content: center;
    margin-top: var(--dev-feature-button-margin-top);
    margin-right: auto;
    margin-left: auto;
    padding: 1rem 2.2rem;
    border: 1px solid var(--dev-feature-button-border);
    border-radius: 0.3rem;
    background: var(--dev-feature-button-background);
    color: var(--dev-feature-button-text);
    font-size: var(--dev-feature-body-mobile);
    font-weight: var(--dev-feature-button-weight);
    text-decoration: none;
    text-transform: uppercase;
  }

  @media screen and (max-width: 749px) {
    #DevProductFeature-{{ section.id }} .dev-product-feature__button {
      display: flex;
      width: fit-content;
      max-width: 100%;
      margin-right: auto;
      margin-left: auto;
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__benefit:nth-child(4) {
      margin-left: 16.666%;
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__benefit:nth-child(5) {
      border-right: 0;
    }
  }

  @media screen and (min-width: 750px) {
    #DevProductFeature-{{ section.id }} .dev-product-feature__inner {
      width: min(
        calc(100% - (var(--dev-feature-padding-inline-desktop) * 2)),
        var(--dev-feature-section-max-width)
      );
      max-width: var(--dev-feature-section-max-width);
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 5rem;
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__inner--full-width {
      width: 100%;
      max-width: none;
      padding-right: var(--dev-feature-padding-inline-desktop);
      padding-left: var(--dev-feature-padding-inline-desktop);
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__media {
      width: 100%;
      max-width: none;
      margin: 0;
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__media--right {
      grid-column: 2;
      grid-row: 1;
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__media--right + .dev-product-feature__content {
      grid-column: 1;
      grid-row: 1;
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__eyebrow {
      font-size: var(--dev-feature-body-desktop);
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__content {
      padding-right: var(--dev-feature-content-padding-inline-desktop);
      padding-left: var(--dev-feature-content-padding-inline-desktop);
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__heading {
      font-size: var(--dev-feature-heading-desktop);
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__description {
      font-size: var(--dev-feature-body-desktop);
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__benefit {
      width: calc(100% / var(--dev-feature-benefits-columns));
      gap: 1.2rem;
      padding: 0 1.2rem;
      border-right: 1px solid color-mix(in srgb, var(--dev-feature-text) 18%, transparent);
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__benefit:last-child {
      border-right: 0;
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__icon {
      width: var(--dev-feature-icon-desktop);
      height: var(--dev-feature-icon-desktop);
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__benefit-copy h3 {
      font-size: var(--dev-feature-benefit-title-desktop);
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__benefit-copy .rte {
      font-size: var(--dev-feature-benefit-text-desktop);
    }

    #DevProductFeature-{{ section.id }} .dev-product-feature__button {
      font-size: var(--dev-feature-body-desktop);
      margin-top: var(--dev-feature-button-margin-top-desktop);
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Dev - Product feature",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Imagen del producto"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo de la imagen",
      "default": "Producto destacado"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posición de la imagen Desktop",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "Best seller"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Performance pilot shirt"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>The lightest pilot shirt ever created.<br>Engineered for comfort. Built for performance.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho completo",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout y espaciado"
    },
    {
      "type": "range",
      "id": "section_max_width",
      "label": "Ancho máximo de la sección",
      "min": 960,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "padding_inline_desktop",
      "label": "Padding lateral Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_inline_mobile",
      "label": "Padding lateral Mobile",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_padding_inline_desktop",
      "label": "Padding columna derecha Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "content_padding_inline_mobile",
      "label": "Padding columna derecha Mobile",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columnas de beneficios Desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "5"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Tamaño título Desktop",
      "min": 20,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Tamaño título Mobile",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "body_size_desktop",
      "label": "Tamaño texto Desktop",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Tamaño texto Mobile",
      "min": 11,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Peso tipográfico"
    },
    {
      "type": "select",
      "id": "eyebrow_weight",
      "label": "Peso etiqueta superior",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Peso título principal",
      "options": [
