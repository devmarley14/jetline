{%- style -%}
  #DevBenefits-{{ section.id }} {
    --dev-benefits-bg: {{ section.settings.background_color }};
    --dev-benefits-max-width: {{ section.settings.max_width }}px;
    --dev-benefits-text: {{ section.settings.text_color }};
    --dev-benefits-accent: {{ section.settings.accent_color }};
    --dev-benefits-icon-size-desktop: {{ section.settings.icon_size_desktop }}px;
    --dev-benefits-icon-size-mobile: {{ section.settings.icon_size_mobile }}px;
    --dev-benefits-title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --dev-benefits-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --dev-benefits-description-size-desktop: {{ section.settings.description_size_desktop }}px;
    --dev-benefits-description-size-mobile: {{ section.settings.description_size_mobile }}px;
    --dev-benefits-gap: {{ section.settings.column_gap }}px;
    --dev-benefits-item-gap-desktop: {{ section.settings.item_gap_desktop }}px;
    --dev-benefits-item-gap-mobile: {{ section.settings.item_gap_mobile }}px;
    --dev-benefits-padding-top: {{ section.settings.padding_top }}px;
    --dev-benefits-padding-bottom: {{ section.settings.padding_bottom }}px;
    --dev-benefits-padding-inline-desktop: {{ section.settings.padding_inline_desktop }}px;
    --dev-benefits-padding-inline-mobile: {{ section.settings.padding_inline_mobile }}px;
    --dev-benefits-card-padding-desktop: {{ section.settings.card_padding_desktop }}px;
    --dev-benefits-card-padding-mobile: {{ section.settings.card_padding_mobile }}px;
    --dev-benefits-radius: {{ section.settings.card_radius }}px;
    --dev-benefits-divider-color: {{ section.settings.divider_color }};
    --dev-benefits-divider-width: {{ section.settings.divider_width }}px;
    --dev-benefits-title-weight: {{ section.settings.title_weight }};
    --dev-benefits-description-weight: {{ section.settings.description_weight }};
  }
{%- endstyle -%}

<section id="DevBenefits-{{ section.id }}" class="dev-benefits">
  <div class="dev-benefits__inner">
    <ul class="dev-benefits__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="dev-benefits__item" {{ block.shopify_attributes }}>
          <div class="dev-benefits__icon" aria-hidden="true">
            {%- if block.settings.svg_code != blank -%}
              {{ block.settings.svg_code }}
            {%- elsif block.settings.icon_image != blank -%}
              {{ block.settings.icon_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {{ 'icon-star' | inline_asset_content }}
            {%- endif -%}
          </div>
          <div class="dev-benefits__content">
            {%- if block.settings.title != blank -%}
              <h3 class="dev-benefits__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <div class="dev-benefits__description rte">{{ block.settings.description }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% style %}
  #DevBenefits-{{ section.id }}.dev-benefits {
    width: 100%;
    max-width: none;
    box-sizing: border-box;
    overflow: hidden;
    background: var(--dev-benefits-bg);
    padding: var(--dev-benefits-padding-top) 0 var(--dev-benefits-padding-bottom);
  }

  #DevBenefits-{{ section.id }} .dev-benefits__inner {
    width: calc(100% - (var(--dev-benefits-padding-inline-mobile) * 2));
    max-width: var(--dev-benefits-max-width);
    margin: 0 auto;
    box-sizing: border-box;
  }

  #DevBenefits-{{ section.id }} .dev-benefits__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--dev-benefits-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #DevBenefits-{{ section.id }} .dev-benefits__item {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: var(--dev-benefits-item-gap-mobile);
    padding: var(--dev-benefits-card-padding-mobile);
    border-radius: var(--dev-benefits-radius);
  }

  #DevBenefits-{{ section.id }} .dev-benefits__icon {
    display: flex;
    width: var(--dev-benefits-icon-size-mobile);
    min-width: var(--dev-benefits-icon-size-mobile);
    height: var(--dev-benefits-icon-size-mobile);
    align-items: center;
    justify-content: center;
    color: var(--dev-benefits-accent);
  }

  #DevBenefits-{{ section.id }} .dev-benefits__icon svg,
  #DevBenefits-{{ section.id }} .dev-benefits__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #DevBenefits-{{ section.id }} .dev-benefits__title {
    margin: 0;
    color: var(--dev-benefits-text);
    font-size: var(--dev-benefits-title-size-mobile);
    font-weight: var(--dev-benefits-title-weight);
    line-height: 1.15;
    text-transform: uppercase;
  }

  #DevBenefits-{{ section.id }} .dev-benefits__description {
    margin-top: 0.6rem;
    color: var(--dev-benefits-text);
    font-size: var(--dev-benefits-description-size-mobile);
    font-weight: var(--dev-benefits-description-weight);
    line-height: 1.5;
  }

  #DevBenefits-{{ section.id }} .dev-benefits__description p {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    #DevBenefits-{{ section.id }} .dev-benefits__inner {
      width: calc(100% - (var(--dev-benefits-padding-inline-desktop) * 2));
    }

    #DevBenefits-{{ section.id }} .dev-benefits__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    }

    #DevBenefits-{{ section.id }} .dev-benefits__item {
      gap: var(--dev-benefits-item-gap-desktop);
      padding: var(--dev-benefits-card-padding-desktop);
    }

    #DevBenefits-{{ section.id }} .dev-benefits__item + .dev-benefits__item {
      border-left: var(--dev-benefits-divider-width) solid var(--dev-benefits-divider-color);
    }

    #DevBenefits-{{ section.id }} .dev-benefits__icon {
      width: var(--dev-benefits-icon-size-desktop);
      min-width: var(--dev-benefits-icon-size-desktop);
      height: var(--dev-benefits-icon-size-desktop);
    }

    #DevBenefits-{{ section.id }} .dev-benefits__title {
      font-size: var(--dev-benefits-title-size-desktop);
    }

    #DevBenefits-{{ section.id }} .dev-benefits__description {
      font-size: var(--dev-benefits-description-size-desktop);
    }
  }

  @media screen and (max-width: 749px) {
    #DevBenefits-{{ section.id }} .dev-benefits__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }

    #DevBenefits-{{ section.id }} .dev-benefits__item {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      text-align: center;
    }

    #DevBenefits-{{ section.id }} .dev-benefits__description {
      font-size: var(--dev-benefits-description-size-mobile);
    }
  }
{% endstyle %}

{% schema %}
